{
  "name": "@schoolai/ts-prompt",
  "version": "0.8.0",
  "license": "MIT",
  "exports": {
    ".": "./mod.ts",
    "./openai.ts": "./openai.ts",
    "./together.ts": "./together.ts"
  },
  "tasks": {
    "dev": "deno run -A mod.ts",
    "test": {
      "command": "echo 'Done'",
      "dependencies": ["test:unit", "test:integration"]
    },
    "test:integration": "deno test -A --env-file=.env *.integration.ts",
    "test:unit": "deno test -A src/*.test.ts",
    "build": "deno run -A build_npm.ts"
  },
  "imports": {
    "zod": "npm:zod@^3.23.0",
    "zod-to-json-schema": "npm:zod-to-json-schema@^3.23.0",
    "^/": "./src/"
  },
  "compilerOptions": {
    "lib": ["esnext", "dom", "deno.ns"]
  },
  "npmRegistry": "https://registry.npmjs.org",
  "test": {
    "include": ["src/**/*.test.ts"]
  }
}
