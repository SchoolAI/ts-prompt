{
  "name": "@schoolai/ts-prompt",
  "version": "0.4.1",
  "license": "MIT",
  "exports": {
    ".": "./mod.ts",
    "./openai.ts": "./openai.ts"
  },
  "tasks": {
    "dev": "deno run -A mod.ts",
    "test:all": "deno test -A --env-file=.env",
    "test": "deno test -A --env-file=.env src/*.test.ts",
    "build": "deno run -A build_npm.ts"
  },
  "imports": {
    "zod": "npm:zod@3.23.8",
    "openai": "npm:openai@4.55.5"
  },
  "compilerOptions": {
    "lib": ["esnext", "dom", "deno.ns"]
  },
  "npmRegistry": "https://registry.npmjs.org",
  "test": {
    "include": ["src/**/*.test.ts"]
  }
}
